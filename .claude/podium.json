{
  "version": 1,
  "name": "podium",
  "stage": "full",
  "language": {
    "conversation": "",
    "artifacts": "en"
  },
  "versioned": true,
  "roles": {
    "setup": "podium",
    "feature": "feat",
    "fix": "fix",
    "investigate": "investigate",
    "faq": "faq",
    "review": "review-pr",
    "comments": "pr-comments",
    "deliver": "deliver"
  },
  "phases": [
    {
      "id": "plan",
      "name": "Plan",
      "short": "Plan",
      "agents": [
        "architect",
        "debugger",
        "Plan"
      ]
    },
    {
      "id": "experts",
      "name": "Experts",
      "short": "Experts",
      "agents": [
        "panel-expert",
        "setup-expert",
        "test-expert",
        "doc-writer",
        "devops"
      ]
    },
    {
      "id": "verify",
      "name": "Verify",
      "short": "Verify",
      "agents": [
        "lint-runner"
      ]
    },
    {
      "id": "review",
      "name": "Reviews",
      "short": "Reviews",
      "agents": [
        "code-reviewer",
        "security-reviewer"
      ]
    }
  ],
  "reviewers": [
    {
      "agent": "code-reviewer",
      "label": "code review",
      "short": "code"
    },
    {
      "agent": "security-reviewer",
      "label": "security review",
      "short": "security"
    }
  ],
  "verification": [
    {
      "step": "build",
      "label": "hook syntax",
      "patterns": [
        "\\bnode\\s+--check\\b"
      ],
      "optional": true
    },
    {
      "step": "lint",
      "label": "validate",
      "patterns": [
        "\\bclaude\\s+plugin\\s+validate\\b"
      ]
    },
    {
      "step": "unit",
      "label": "tests",
      "patterns": [
        "\\bclaude\\s+plugin\\s+test\\b"
      ]
    }
  ],
  "layers": [
    {
      "name": "Tests",
      "pattern": "^plugin/tests/"
    },
    {
      "name": "Panel",
      "pattern": "^plugin/(hooks|types)/"
    },
    {
      "name": "Setup skill",
      "pattern": "^plugin/skills/"
    },
    {
      "name": "Plugin and CI",
      "pattern": "^(\\.claude-plugin/|plugin/\\.claude-plugin/|\\.github/|\\.editorconfig$|\\.gitattributes$|\\.gitignore$|plugin/tsconfig\\.json$|plugin/LICENSE$|LICENSE$)"
    },
    {
      "name": "Documentation",
      "pattern": "^(README|CHANGELOG|CONTRIBUTING|SECURITY)\\.md$|^plugin/README\\.md$|^plugin/assets/"
    }
  ],
  "code": {
    "roots": "^plugin/(hooks|types|tests|skills/setup/templates/hooks)/",
    "extensions": "\\.(ts|tsx|mjs)$",
    "ignore": "(^|/)(node_modules|\\.claude-plugin/types|\\.claude|\\.mcpb-cache)/"
  },
  "generated": "^plugin/\\.claude-plugin/types/",
  "checks": {
    "comments": true,
    "noFreeFunction": true,
    "aiMention": true,
    "partition": true,
    "hooks": true
  },
  "git": {
    "base": "main",
    "featurePrefixes": [
      "feat/"
    ],
    "fixPrefixes": [
      "fix/"
    ],
    "support": "",
    "workItem": ""
  },
  "theme": "",
  "hooks": {
    "protectedBranches": "(?!)",
    "commitPattern": "^(?!.*\\.$)[A-Z].{1,71}$",
    "commitExample": "Seat the orchestrator at a desk in an office",
    "prDraft": false,
    "commentAllow": "^\\s*//\\s*(Arrange|Act|Assert)\\b",
    "partitions": {
      "panel-expert": "^plugin/(hooks|types)/",
      "setup-expert": "^plugin/skills/",
      "test-expert": "^plugin/tests/",
      "doc-writer": "^(README|CHANGELOG|CONTRIBUTING|SECURITY)\\.md$|^plugin/README\\.md$|^plugin/assets/",
      "devops": "^(\\.github/|\\.claude-plugin/|plugin/\\.claude-plugin/(?!types/)|plugin/tsconfig\\.json$|plugin/LICENSE$|\\.editorconfig$|\\.gitattributes$|\\.gitignore$|LICENSE$)"
    },
    "readOnlyAgents": [
      "architect",
      "debugger",
      "code-reviewer",
      "security-reviewer",
      "lint-runner",
      "Explore",
      "Plan"
    ],
    "safeRemove": "(^|/)(node_modules|dist|build|coverage|tmp|\\.mcpb-cache)/?$|scratchpad",
    "secrets": "(^|/)\\.env(\\.(?!example|template)[\\w.-]+)?$|\\.(pem|key|p12|pfx)$|(^|/)secrets?/",
    "workItemCommand": "",
    "workItemMention": ""
  },
