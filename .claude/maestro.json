{
  "version": 1,
  "name": "maestro",
  "stage": "full",
  "language": {
    "conversation": "",
    "artifacts": "en"
  },
  "versioned": true,
  "roles": {
    "setup": "maestro",
    "feature": "feat",
    "fix": "fix",
    "investigate": "investigate",
    "faq": "faq",
    "review": "review-pr",
    "comments": "pr-comments",
    "deliver": "deliver"
  },
  "phases": [
    {
      "id": "plan",
      "name": "Plan",
      "short": "Plan",
      "agents": [
        "architect",
        "debugger",
        "Plan"
      ]
    },
    {
      "id": "experts",
      "name": "Experts",
      "short": "Experts",
      "agents": [
        "panel-expert",
        "setup-expert",
        "test-expert",
        "doc-writer",
        "devops"
      ]
    },
    {
      "id": "verify",
      "name": "Verify",
      "short": "Verify",
      "agents": [
        "lint-runner"
      ]
    },
    {
      "id": "review",
      "name": "Reviews",
      "short": "Reviews",
      "agents": [
        "code-reviewer",
        "security-reviewer"
      ]
    }
  ],
  "reviewers": [
    {
      "agent": "code-reviewer",
      "label": "code review",
      "short": "code"
    },
    {
      "agent": "security-reviewer",
      "label": "security review",
      "short": "security"
    }
  ],
  "verification": [
    {
      "step": "build",
      "label": "hook syntax",
      "patterns": [
        "\\bnode\\s+--check\\b"
      ],
      "optional": true
    },
    {
      "step": "lint",
      "label": "validate",
      "patterns": [
        "\\bclaude\\s+plugin\\s+validate\\b"
      ]
    },
    {
      "step": "unit",
      "label": "tests",
      "patterns": [
        "\\bclaude\\s+plugin\\s+test\\b"
      ]
    }
  ],
  "layers": [
    {
      "name": "Tests",
      "pattern": "^tests/"
    },
    {
      "name": "Panel",
      "pattern": "^(hooks|types)/"
    },
    {
      "name": "Setup skill",
      "pattern": "^skills/"
    },
    {
      "name": "Plugin and CI",
      "pattern": "^(\\.claude-plugin/|\\.github/|\\.editorconfig$|\\.gitattributes$|\\.gitignore$|tsconfig\\.json$|LICENSE$)"
    },
    {
      "name": "Documentation",
      "pattern": "^(README|CHANGELOG|CONTRIBUTING|SECURITY)\\.md$|^assets/"
    }
  ],
  "code": {
    "roots": "^(hooks|types|tests|skills/setup/templates/hooks)/",
    "extensions": "\\.(ts|tsx|mjs)$",
    "ignore": "(^|/)(node_modules|\\.claude-plugin/types|\\.claude|\\.mcpb-cache)/"
  },
  "generated": "^\\.claude-plugin/types/",
  "checks": {
    "comments": true,
    "noFreeFunction": true,
    "aiMention": true,
    "partition": true,
    "hooks": true
  },
  "git": {
    "base": "main",
    "featurePrefixes": [
      "feat/"
    ],
    "fixPrefixes": [
      "fix/"
    ],
    "support": "",
    "workItem": ""
  },
  "theme": "",
  "hooks": {
    "protectedBranches": "(?!)",
    "commitPattern": "^(?!.*\\.$)[A-Z].{1,71}$",
    "commitExample": "Seat the orchestrator at a desk in an office",
    "prDraft": false,
    "commentAllow": "^\\s*//\\s*(Arrange|Act|Assert)\\b",
    "partitions": {
      "panel-expert": "^(hooks|types)/",
      "setup-expert": "^skills/",
      "test-expert": "^tests/",
      "doc-writer": "^(README|CHANGELOG|CONTRIBUTING|SECURITY)\\.md$|^assets/",
      "devops": "^(\\.github/|\\.claude-plugin/(?!types/)|\\.editorconfig$|\\.gitattributes$|\\.gitignore$|tsconfig\\.json$|LICENSE$)"
    },
    "readOnlyAgents": [
      "architect",
      "debugger",
      "code-reviewer",
      "security-reviewer",
      "lint-runner",
      "Explore",
      "Plan"
    ],
    "safeRemove": "(^|/)(node_modules|dist|build|coverage|tmp|\\.mcpb-cache)/?$|scratchpad",
    "secrets": "(^|/)\\.env(\\.(?!example|template)[\\w.-]+)?$|\\.(pem|key|p12|pfx)$|(^|/)secrets?/",
    "workItemCommand": "",
    "workItemMention": ""
  },
